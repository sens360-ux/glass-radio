<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:orientation="vertical"
    android:background="@drawable/selector_daily_row_bg"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="21dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/dailyDay"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="Today"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dailyIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_sun" />

            <TextView
                android:id="@+id/dailyRain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="85%"
                android:textColor="#38BDF8"
                android:textSize="8.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dailyMinTemp"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:gravity="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="24°"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <com.gathin.tvhome.TempRangeBarView
            android:id="@+id/dailyTempBar"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dailyMaxTemp"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:gravity="start"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="29°"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/dailyDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#10FFFFFF" />
</LinearLayout>
