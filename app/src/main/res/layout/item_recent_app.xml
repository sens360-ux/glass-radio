<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top mini-pill with small icon and label -->
    <LinearLayout
        android:id="@+id/topPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_app_pill_unfocused"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSmallIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:maxLines="1"
            android:maxWidth="260dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main App Card with realistic deep drop shadow -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="420dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_recent_card"
        android:clickable="true"
        android:elevation="28dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Centered Squircle Tile -->
        <FrameLayout
            android:id="@+id/squircleContainer"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_app_squircle"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/ivCardIcon"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </FrameLayout>

    </FrameLayout>

</LinearLayout>
