<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A111E"
    android:clipChildren="false">

    <!-- Layer 0: Hardware-Accelerated Dynamic Atmospheric Weather Canvas -->
    <com.gathin.tvhome.WeatherBackgroundView
        android:id="@+id/weatherBgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Apple Weather Widescreen Frosted Glass UI -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <!-- Top Header: Apple Weather Center Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weatherSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.12"
                    android:singleLine="true"
                    android:text="MY LOCATION"
                    android:textAllCaps="true"
                    android:textColor="#C8DCF8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/weatherLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:singleLine="true"
                    android:text="Putrajaya"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/weatherMainTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="10"
                    android:singleLine="true"
                    android:text="29°"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/weatherMainCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="5"
                    android:singleLine="true"
                    android:text="Drizzle"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/weatherMainSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:text="H:30°  L:24°"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnChangeLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_location_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="2.5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="2.5dp"
                    android:text="📍 Tukar Stesen / Suasana"
                    android:textColor="@color/selector_pill_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Main Widescreen Body: Bento Grid (Exact Height: 385dp) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="385dp"
                android:layout_marginTop="7dp"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <!-- LEFT SECTION: 2x4 Metric Grid Tiles (Total Height: 385dp) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:orientation="vertical">

                    <!-- Row 1: WIND & MOON PHASE (92dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <!-- Tile 1A: WIND -->
                        <LinearLayout
                            android:id="@+id/tileWind"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="💨  WIND"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <com.gathin.tvhome.WindCompassView
                                android:id="@+id/windCompassView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </LinearLayout>

                        <!-- Tile 1B: MOON PHASE -->
                        <LinearLayout
                            android:id="@+id/tileMoon"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="🌕  WANING GIBBOUS"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <com.gathin.tvhome.MoonPhaseView
                                android:id="@+id/moonPhaseView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: SUNSET & UV INDEX (91dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="91dp"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <!-- Tile 2A: SUNSET -->
                        <LinearLayout
                            android:id="@+id/tileSunset"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="🌅  SUNSET"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/sunsetText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:text="6:57 PM"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />

                            <com.gathin.tvhome.SunArcView
                                android:id="@+id/sunArcView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </LinearLayout>

                        <!-- Tile 2B: UV INDEX -->
                        <LinearLayout
                            android:id="@+id/tileUv"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="☀️  UV INDEX"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/uvValText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 700"
                                    android:includeFontPadding="false"
                                    android:text="6"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/uvDescText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 600"
                                    android:includeFontPadding="false"
                                    android:text="High"
                                    android:textColor="#F59E0B"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <com.gathin.tvhome.AqiSpectrumBarView
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="Use sun protection until 5PM."
                                android:textColor="#CBD5E1"
                                android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 3: FEELS LIKE & AIR QUALITY (92dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <!-- Tile 3A: FEELS LIKE -->
                        <LinearLayout
                            android:id="@+id/tileFeelsLike"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="🌡️  FEELS LIKE"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/feelsLikeVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:text="30°"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:text="It feels warmer than actual temperature."
                                android:textColor="#CBD5E1"
                                android:textSize="8sp" />
                        </LinearLayout>

                        <!-- Tile 3B: AIR QUALITY -->
                        <LinearLayout
                            android:id="@+id/tileAqi"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="🍃  AIR QUALITY"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/aqiValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 700"
                                    android:includeFontPadding="false"
                                    android:text="56"
                                    android:textColor="#38BDF8"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/aqiStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 600"
                                    android:includeFontPadding="false"
                                    android:text="Moderate"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <com.gathin.tvhome.AqiSpectrumBarView
                                android:id="@+id/aqiBar"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/aqiStation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="SK Putrajaya Presint 18"
                                android:textColor="#94A3B8"
                                android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 4: PRECIPITATION & VISIBILITY (92dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:orientation="horizontal">

                        <!-- Tile 4A: PRECIPITATION -->
                        <LinearLayout
                            android:id="@+id/tilePrecip"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="💧  PRECIPITATION"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:text="13 mm"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="in last 24h • 21 mm expected"
                                android:textColor="#CBD5E1"
                                android:textSize="8sp" />
                        </LinearLayout>

                        <!-- Tile 4B: VISIBILITY -->
                        <LinearLayout
                            android:id="@+id/tileVisibility"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/weather_card_bg"
                            android:orientation="vertical"
                            android:padding="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="👁️  VISIBILITY"
                                android:textColor="#94A3B8"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:text="12 km"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 400"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="Clear view."
                                android:textColor="#CBD5E1"
                                android:textSize="8sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- RIGHT SECTION: Hourly (Top: 127dp) + 10-Day & Radar (Bottom: 252dp) (Total Height: 385dp) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.88"
                    android:orientation="vertical">

                    <!-- Top Card: Hourly Conditions (127dp) -->
                    <LinearLayout
                        android:id="@+id/cardHourly"
                        android:layout_width="match_parent"
                        android:layout_height="127dp"
                        android:background="@drawable/weather_card_bg"
                        android:clickable="false"
                        android:focusable="false"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:text="Conditions"
                                android:textColor="#FFFFFF"
                                android:textSize="12.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 500"
                                android:includeFontPadding="false"
                                android:text="Temperature (°C)"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />

                            <!-- Apple Weather 3-tab Toolbar Toggles -->
                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:background="@drawable/bg_weather_tab_active"
                                    android:padding="3dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/wx_cloud" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="4dp"
                                    android:padding="3.5dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_wx_droplet" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="4dp"
                                    android:padding="3.5dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_wx_wind" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:background="#12FFFFFF" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="4dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:fillViewport="true"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/hourlyContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <!-- Bottom Row: 10-Day Forecast & Radar / Metrics (252dp) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="252dp"
                        android:layout_marginTop="6dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Left: 10-DAY FORECAST (252dp) -->
                        <LinearLayout
                            android:id="@+id/cardDaily"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1.0"
                            android:background="@drawable/weather_card_bg"
                            android:clickable="false"
                            android:focusable="false"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit"
                                android:fontVariationSettings="'wght' 700"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:singleLine="true"
                                android:text="📅  10-DAY FORECAST"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="3dp"
                                android:layout_marginBottom="2dp"
                                android:background="#12FFFFFF" />

                            <LinearLayout
                                android:id="@+id/dailyContainer"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <!-- Right: PRECIPITATION RADAR MAP & HUMIDITY / PRESSURE (252dp) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.08"
                            android:orientation="vertical">

                            <!-- Radar Card (170dp) -->
                            <LinearLayout
                                android:id="@+id/cardRadar"
                                android:layout_width="match_parent"
                                android:layout_height="170dp"
                                android:background="@drawable/weather_card_bg"
                                android:orientation="vertical"
                                android:padding="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 700"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="0.08"
                                    android:singleLine="true"
                                    android:text="☂  PRECIPITATION"
                                    android:textColor="#94A3B8"
                                    android:textSize="10sp" />

                                <com.gathin.tvhome.RadarMapView
                                    android:id="@+id/radarMapView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="3dp" />
                            </LinearLayout>

                            <!-- Bottom Row below Radar: HUMIDITY & PRESSURE (76dp) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="76dp"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <!-- HUMIDITY -->
                                <LinearLayout
                                    android:id="@+id/tileHumidity"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/weather_card_bg"
                                    android:orientation="vertical"
                                    android:padding="6dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/outfit"
                                        android:fontVariationSettings="'wght' 700"
                                        android:includeFontPadding="false"
                                        android:letterSpacing="0.08"
                                        android:singleLine="true"
                                        android:text="💧  HUMIDITY"
                                        android:textColor="#94A3B8"
                                        android:textSize="9sp" />

                                    <TextView
                                        android:id="@+id/humidityValText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/outfit"
                                        android:fontVariationSettings="'wght' 700"
                                        android:includeFontPadding="false"
                                        android:text="79%"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:ellipsize="end"
                                        android:fontFamily="@font/outfit"
                                        android:fontVariationSettings="'wght' 400"
                                        android:includeFontPadding="false"
                                        android:singleLine="true"
                                        android:text="The dew point is 25° right now."
                                        android:textColor="#CBD5E1"
                                        android:textSize="8sp" />
                                </LinearLayout>

                                <!-- PRESSURE -->
                                <LinearLayout
                                    android:id="@+id/tilePressure"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/weather_card_bg"
                                    android:orientation="vertical"
                                    android:padding="6dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/outfit"
                                        android:fontVariationSettings="'wght' 700"
                                        android:includeFontPadding="false"
                                        android:letterSpacing="0.08"
                                        android:singleLine="true"
                                        android:text="⏱️  PRESSURE"
                                        android:textColor="#94A3B8"
                                        android:textSize="9sp" />

                                    <com.gathin.tvhome.PressureGaugeView
                                        android:id="@+id/pressureGaugeView"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Disclaimer Footer -->
            <TextView
                android:id="@+id/weatherFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:text="Jabatan Alam Sekitar (APIMS)  •  Open-Meteo Atmospheric Model"
                android:textColor="#40FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
